# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================================
# SUPABASE — CRITICAL
# ============================================================
# VITE_SUPABASE_URL: Project URL from Supabase Dashboard -> Settings -> API.
VITE_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# VITE_SUPABASE_ANON_KEY: Public anon key. Used by the browser client.
# The anon key is ALWAYS subject to Row Level Security (RLS).
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Secret server-only key. MUST BE SET.
# The Node server (/api/db/* proxies) uses this key to bypass RLS.
# WITHOUT this key the server falls back to the anon key, RLS blocks every
# write, and the whole app stops working as soon as RLS is enabled.
# Get it from: Supabase Dashboard -> Settings -> API -> service_role (secret).
# NEVER expose this key to the browser; it is read only server-side in server.ts.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_SECRET_KEY"

# Optional override for the AI provider key used server-side.
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"
